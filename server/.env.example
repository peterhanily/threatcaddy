# Database
DATABASE_URL=postgres://tc:tc@db:5432/threatcaddy

# Server
PORT=3001
ADMIN_PORT=3002
FILE_STORAGE_PATH=/data/files

# CORS — comma-separated origins (default: * allows all)
ALLOWED_ORIGINS=https://your-app.example.com

# JWT Ed25519 keys (required)
# Generate with:
#   openssl genpkey -algorithm Ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Then set as single-line values (replace newlines with \n)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Admin panel secret (optional — auto-generated on first launch if not set)
ADMIN_SECRET=

# Trust proxy headers (X-Forwarded-For) for rate limiting
# Set to true or 1 only behind a reverse proxy. False and 0 disable it.
TRUST_PROXY=0
# Exact socket peer IPs only; Docker proxies usually need their actual bridge IP.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Combined retained file/backup byte quotas (positive integers)
STORAGE_QUOTA_PER_USER_BYTES=2147483648
STORAGE_QUOTA_TOTAL_BYTES=21474836480

# LLM API keys (optional — enable AI features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Persistent bot-credential encryption (required in every environment).
# For NEW installations: openssl rand -hex 32
# Preserve the exact existing configured key when upgrading; see docs/credential-recovery.md.
BOT_MASTER_KEY=

# Optional machine-to-machine alert ingestion; both fields are required to enable it.
WEBHOOK_INGEST_SECRET=
# Existing active analyst/admin user ID that receives investigation ownership.
WEBHOOK_INGEST_OWNER_ID=
