# Docker Compose configuration. Copy to .env at the repository root.
# Do not commit .env or use these blank values in a running deployment.
# See docs/deployment.md for key generation and server/docs/runtime-operations.md
# for backup, key preservation and coordinated upgrades.

# Required: choose a strong database password. Compose derives DATABASE_URL.
POSTGRES_PASSWORD=

# Required: stable key (new installations: 32 random bytes encoded as hex).
# Preserve the exact existing value with your recovery material;
# changing it does not decrypt existing bot credentials.
BOT_MASTER_KEY=

# Required: matching Ed25519 PEM keys. In a local .env, use quoted values with
# escaped newlines as described in docs/deployment.md.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Required: replace with your exact client origin; comma-separate additional
# approved origins. No wildcard. Do not include a path or trailing slash.
ALLOWED_ORIGINS=https://your-client.example

# Optional bootstrap secret. If omitted, the server generates one; see deployment
# instructions for first-admin setup. Keep the admin port private.
ADMIN_SECRET=

# Optional provider credentials. Leave blank when these services are unused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
