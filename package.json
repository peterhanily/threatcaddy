{
  "name": "threatcaddy",
  "description": "ThreatCaddy — Local-first threat investigation workspace with optional team collaboration.",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "10.29.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.single.ts",
    "lint": "node scripts/check-lint.mjs",
    "lint:raw": "eslint .",
    "perf:startup": "node scripts/measure-startup.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:extension": "npm --prefix extension test",
    "test:server": "npm --prefix server test",
    "test:integration": "npm --prefix server run test:integration",
    "build:extension": "cd extension && npm run build",
    "build:extension:chrome": "cd extension && npm run build:chrome",
    "build:extension:firefox": "cd extension && npm run build:firefox",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:release:unit": "node --test scripts/release-contract.test.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "test:ci": "node --test scripts/ci-*.test.mjs",
    "translate": "node scripts/translate-i18n.mjs",
    "translate:dry": "node scripts/translate-i18n.mjs --dry-run",
    "translate:sync": "node scripts/translate-i18n.mjs --sync",
    "translate:sync:dry": "node scripts/translate-i18n.mjs --sync --dry-run",
    "locales:check": "node scripts/check-locales.mjs",
    "locales:report": "node scripts/check-locales.mjs --report",
    "deploy": "gh workflow run deploy.yml --ref main"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "cytoscape": "^3.34.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dexie": "^4.4.7",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.11",
    "i18next-http-backend": "4.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "1.61.0",
    "marked": "^18.1.2",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.16",
    "pako": "^3.0.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.19",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/diff-match-patch": "^1.0.36",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "js-yaml": "4.3.2",
    "jsdom": "^28.1.0",
    "rollup": "^4.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
