{
  "name": "threatcaddy",
  "description": "ThreatCaddy — Threat Investigation Workspace. Notes, IOCs, Timelines & Graphs. No server. No tracking.",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.29.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.single.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:extension": "npm --prefix extension test",
    "test:server": "npm --prefix server test",
    "test:integration": "npm --prefix server run test:integration",
    "build:extension": "cd extension && npm run build",
    "build:extension:chrome": "cd extension && npm run build:chrome",
    "build:extension:firefox": "cd extension && npm run build:firefox",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "translate": "node scripts/translate-i18n.mjs",
    "translate:dry": "node scripts/translate-i18n.mjs --dry-run",
    "translate:sync": "node scripts/translate-i18n.mjs --sync",
    "translate:sync:dry": "node scripts/translate-i18n.mjs --sync --dry-run",
    "deploy": "gh workflow run deploy.yml --ref main"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dexie": "^4.4.6",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^3.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.6",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.16",
    "pako": "^2.2.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.15",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/diff-match-patch": "^1.0.36",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.6",
    "@types/pako": "^2.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "rollup": "^4.63.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
